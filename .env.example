# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Optional: WebSocket base URL. If unset, it's derived automatically from
# VITE_API_URL by swapping http(s) -> ws(s).
# VITE_WS_URL=ws://localhost:8000

# Optional: Map tile server URL template for Leaflet.
# Defaults to public OpenStreetMap when unset.
# For local offline jathara deployments, serve tiles from a local server
# (e.g. MBTiles/mbtileserver or local Nginx proxy):
# VITE_MAP_TILE_URL=http://localhost:8080/tiles/{z}/{x}/{y}.png

